# Central settings for the locked-down child laptop.
# Sourced by all scripts. Edit here, not in individual scripts.

# --- Accounts ---
CHILD_USER="alayet"
CHILD_FULLNAME="Alayet"
PARENT_USER="yohannes"        # admin account; already exists (current user, has sudo)

# --- Paths ---
ETC_DIR="/etc/parental"                       # config + generated artifacts live here
ALLOWLIST="${ETC_DIR}/allowlist.txt"          # installed copy of config/allowlist.txt
YT_ALLOWLIST="${ETC_DIR}/youtube-allow.txt"   # installed copy of config/youtube-allow.txt
LOG_DIR="/var/log/parental"                   # root-owned logs (URLs, prompts, blocks)
EXT_DIR="/opt/parental/extension"             # unpacked Chromium extension

# --- Network ---
PROXY_PORT="3128"                  # Squid transparent port
DNS_PORT="53"                      # dnsmasq
PROXY_LISTEN="127.0.0.1"

# --- YouTube Restricted Mode level: "moderate" or "strict" ---
YOUTUBE_RESTRICT="strict"          # CNAME target: restrictmoderate.youtube.com / restrict.youtube.com

# --- Log shipping (optional). Leave empty to keep logs local only. ---
REMOTE_SYSLOG=""                   # e.g. "logs.example.com:514"

# --- Health monitoring + Telegram alerts (see scripts/06-monitoring.sh) ---
# Secret bot token + chat id live in /etc/parental/telegram.env (root-only), NOT here.
HEALTHCHECK_INTERVAL="5min"        # how often the health check runs
ALERT_THRESHOLD="3"                # consecutive failing cycles before alerting (~15 min at 5min)
ALERT_REPEAT_HOURS="6"             # re-alert this often while a problem persists
ALERT_DAILY_OK="0"                 # "1" = also send a daily "all healthy" heartbeat
TELEGRAM_PROXY="127.0.0.1:3128"    # alerts egress via Squid (the only outbound path); "" = direct
