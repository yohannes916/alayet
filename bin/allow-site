#!/usr/bin/env bash
# allow-site <domain> [<domain> ...]
# Add one or more domains to the allowlist and regenerate every layer live.
set -euo pipefail
PREFIX="/opt/parental"
# shellcheck disable=SC1091
source "${PREFIX}/scripts/lib.sh"
require_root

[[ "$#" -ge 1 ]] || die "Usage: allow-site <domain> [<domain> ...]"

for d in "$@"; do
  d="$(echo "$d" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  [[ -n "$d" ]] || continue
  if read_list "$(installed_allowlist)" | grep -qxF "$d"; then
    warn "Already allowed: $d"
  else
    echo "$d" >> "$(installed_allowlist)"
    ok "Added: $d"
  fi
done

"${PREFIX}/scripts/regenerate.sh"
